generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Year {
  id   Int    @id @default(autoincrement())
  year Int
  days Day[]
}

model Day {
  id      Int      @id @default(autoincrement())
  date    DateTime
  yearId  Int
  year    Year     @relation(fields: [yearId], references: [id])
  artists Artist[]
}

model Artist {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  link        String?
  imageUrl    String?
  time        DateTime?
  dayId       Int?
  day         Day?      @relation(fields: [dayId], references: [id])
}
