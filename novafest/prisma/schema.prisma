// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Year {
  id      Int      @id @default(autoincrement())
  year    Int
  artists Artist[]
}

model Artist {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  link        String?
  imageUrl    String?
  time        DateTime?
  stage       String?
  yearId      Int
  year        Year      @relation(fields: [yearId], references: [id])
}